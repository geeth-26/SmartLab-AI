# Copy to your shell environment (the app reads real environment variables).
ANTHROPIC_API_KEY=
SMARTLAB_LLM_MODEL=claude-opus-5-5
SMARTLAB_LLM_EFFORT=medium
SMARTLAB_EMBEDDINGS=auto
SMARTLAB_VECTOR_STORE=auto
